# Copy to .env.supabase.local (ignored by Git); only backend reads these.
SUPABASE_DB_HOST=YOUR_SESSION_POOLER_HOST
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_SSLMODE=require

MYSQL_SOURCE_HOST=YOUR_READONLY_SOURCE_HOST
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=YOUR_READONLY_USER
MYSQL_SOURCE_PASSWORD=YOUR_SOURCE_PASSWORD

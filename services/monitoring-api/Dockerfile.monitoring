FROM python:3.12-slim
WORKDIR /app
COPY requirements-monitoring.txt requirements.txt ./
ARG INSTALL_PREDICTIONS=false
RUN pip install --no-cache-dir -r requirements-monitoring.txt && \
    if [ "$INSTALL_PREDICTIONS" = "true" ]; then pip install --no-cache-dir -r requirements.txt; fi
COPY api ./api
COPY monitoring ./monitoring
COPY configs ./configs
COPY imports ./imports
COPY src ./src
COPY models ./models
ENV PYTHONPATH=/app:/app/src
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
